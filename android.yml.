name: Build Android Mod

on:
workflow_dispatch:
push:
branches:
- "**"

jobs:
build:
runs-on: ubuntu-latest

steps:  
  - name: Download repository  
    uses: actions/checkout@v4  

  - name: Compile Geode mod  
    id: build  
    uses: geode-sdk/build-geode-mod@main  
    with:  
      target: Android64  
      sdk: given  

  - name: Save compiled mod  
    uses: actions/upload-artifact@v4  
    with:  
      name: Predictive-Buffer-Android64  
      path: ${{ steps.build.outputs.build-output }}/*.geode  
      if-no-files-found: error
